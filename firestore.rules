rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Users collection - users can read/write their own profile
    match /users/{userId} {
      allow read: if true; // Allow reading for username checks
      allow create: if request.auth.uid == userId; // Allow creation during signup
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false; // Prevent deletion
    }

    // Bets collection - users can only access their own bets
    match /bets/{betId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
